 "seurat-processor.app.yml": {
  "manifest": {
   "Value": {
    "description": {
     "Value": "Processes Seurat Objects (.rds) and exports UMAP embeddings, metadata, and gene expression data to Parquet files for web visualization."
    },
    "inputs": {
     "Value": [
      {
       "Value": {
        "description": {
         "Value": "A Seurat object saved with saveRDS (.rds)."
        },
        "mediaTypes": {
         "Value": [
          {
           "Value": "application/x-rds"
          }
         ]
        },
        "name": {
         "Value": "seurat-object"
        }
       }
      }
     ]
    },
    "name": {
     "Value": "Seurat Processor"
    },
    "outputs": {
     "Value": [
      {
       "Value": {
        "description": {
         "Value": "UMAP embeddings, cell metadata and gene expression as Parquet files, for the UMAP viewer."
        },
        "mediaTypes": {
         "Value": [
          {
           "Value": "application/vnd.apache.parquet"
          }
         ]
        },
        "name": {
         "Value": "parquet"
        }
       }
      }
     ]
    },
    "parameters": {
     "Value": [
      {
       "Value": {
        "defaultValue": {
         "Value": "expanded"
        },
        "description": {
         "Value": "Output mode - \"expanded\" for multi-file parquet (PrecisionDashWidgets) or \"consolidated\" for single results.parquet (legacy)"
        },
        "name": {
         "Value": "OUTPUT_MODE"
        },
        "required": {
         "Value": false
        },
        "type": {
         "Value": "string"
        }
       }
      },
      {
       "Value": {
        "defaultValue": {
         "Value": "500"
        },
        "description": {
         "Value": "Number of genes per chunk file"
        },
        "name": {
         "Value": "CHUNK_SIZE"
        },
        "required": {
         "Value": false
        },
        "type": {
         "Value": "number"
        }
       }
      },
      {
       "Value": {
        "defaultValue": {
         "Value": "true"
        },
        "description": {
         "Value": "Compute peak-gene links for multiome datasets (\"true\" or \"false\")"
        },
        "name": {
         "Value": "LINK_PEAKS"
        },
        "required": {
         "Value": false
        },
        "type": {
         "Value": "string"
        }
       }
      },
      {
       "Value": {
